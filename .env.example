# Public site URL (no trailing slash). Defaults to https://kalamkrutha-studio.vercel.app
NEXT_PUBLIC_SITE_URL=
# Set to "true" at launch to allow search engines to index the site
NEXT_PUBLIC_ALLOW_INDEXING=false

# Resend email notifications (server only)
RESEND_API_KEY=
# Where enquiry notifications are sent
ADMIN_EMAIL=
# Sender on a domain verified in Resend; enables customer confirmation emails when set
RESEND_FROM_EMAIL=

# WhatsApp Cloud API admin alerts (server only)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Admin number in international format without + (e.g. 918885858111)
ADMIN_WHATSAPP_NUMBER=

# Cloudflare Turnstile (spam protection on the contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (all optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=

# Social profiles: icons render only for URLs set here
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
